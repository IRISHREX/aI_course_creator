# MongoDB connection string (Atlas or self-hosted). Must be a replica set for Prisma.
# Atlas example:
DATABASE_URL="mongodb+srv://USER:PASS@cluster0.mongodb.net/ignouprep?retryWrites=true&w=majority"
# Local replica set example:
# DATABASE_URL="mongodb://localhost:27017/ignouprep?replicaSet=rs0"

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
PORT=5000
CORS_ORIGIN=http://localhost:5173,http://localhost:8080,https://ignouprep.lovable.app

# Google Gemini API
GOOGLE_AI_API_KEY=

# Bootstrap super admin (email gets super_admin role on signup)
SUPER_ADMIN_EMAILS=soheljavadeveloper@gmail.com,sohejavadeveloper@gmail.com

# Only needed for one-time data migration from Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
